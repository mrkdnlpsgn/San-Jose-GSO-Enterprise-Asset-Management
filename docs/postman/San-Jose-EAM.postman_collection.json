{
  "info": {
    "name": "San Jose GSO — Enterprise Asset Management API",
    "description": "REST API for the Web-Based Inventory and Tracking Management System of ICT Devices (San Jose Municipal Hall). Auth is JWT stored in an HttpOnly cookie set by /api/auth/login — Postman's cookie jar attaches it automatically to subsequent requests in this collection, no manual token handling needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "assetId", "value": "1", "type": "string" },
    { "key": "categoryId", "value": "1", "type": "string" },
    { "key": "officeId", "value": "1", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" },
    { "key": "equipmentId", "value": "1", "type": "string" },
    { "key": "deviceId", "value": "1", "type": "string" },
    { "key": "maintenanceId", "value": "1", "type": "string" },
    { "key": "disposalId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Sets the jwt HttpOnly cookie on success. Response body contains the user object."
          }
        },
        {
          "name": "Login (staff)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"ict_staff\",\n  \"password\": \"ict2024\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] },
            "description": "Returns 401 if called without a valid jwt cookie — proves JwtAuthFilter is enforcing auth."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "description": "Clears the jwt cookie."
          }
        }
      ]
    },
