# Environment file for docker-compose
# Copy to .env and update values as needed

# Database
DB_ROOT_PASSWORD=rootpassword
DB_NAME=sj_gso_inventory
DB_USER=app
DB_PASSWORD=apppassword
DB_PORT=3306

# Backend
BACKEND_PORT=8080
SPRING_PROFILE=prod
# 'validate' fails at startup: entity IDs are Java Long but the schema uses INT
# columns everywhere (not BIGINT), which strict validation rejects. 'update' is
# what local dev has always run against successfully — same tolerant behavior.
HIBERNATE_DDL=update
# Required — JwtUtil has no default and startup fails without it. Generate with:
# openssl rand -base64 48
JWT_SECRET=
# Token lifetime in ms. Defaults to 28800000 (8h) if left blank.
JWT_EXPIRATION=

# Email notifications (optional) — leave MAIL_USERNAME/PASSWORD/FROM blank and
# NOTIFICATIONS_ENABLED=false to keep this disabled. MAIL_HOST still defaults to
# smtp.gmail.com even when disabled: Spring only creates the mail sender bean
# when a host is present, and the backend won't start without that bean.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
NOTIFICATIONS_ENABLED=false

# Login rate limit — shared per source IP across every account attempted from
# it, not per-username. Raise if testing multiple accounts from one machine
# keeps tripping the "too many login attempts" lockout.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# AI Insight tab (asset lifecycle recommendations) — get a free key at
# aistudio.google.com/apikey. Leave blank to keep AI features disabled.
GEMINI_API_KEY=

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080
